<UserControl x:Class="TerminalApp.TabHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mtu="using:Microsoft.Terminal.UI"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             MinHeight="16"
             mc:Ignorable="d">

    <Grid x:Name="HeaderRootGrid"
          HorizontalAlignment="Left">
        <!--  Agentmaster (Linked Lenses): the "selected/active" pill — a filled accent background
              drawn BEHIND the header content (first Grid child, so the icon/dot/title render on top).
              The Grid sizes to the header StackPanel; the NEGATIVE Margin then grows the pill OUTWARD
              past the content on all sides (it stays Stretch, so a negative margin makes it larger
              than its cell) for breathing room — a rounded pill, not a tight box hugging the glyphs —
              WITHOUT shifting the content (the icon/dot/title don't move). Shown ONLY while the Agent
              Manager tab is active and this session is hovered/selected in the Manager
              (TerminalPage::_SetTabSelectionPill drives AgentSelectionVisible/Brush via Tab.TabStatus()).
              Presentation-only: the Manager tab stays the actually-selected tab, and this never touches
              the per-dir tab color (Rule #12).
              The negative LEFT is safe HERE (unlike the dot, which must also work on no-icon shell
              tabs): the pill only ever shows on a MANAGED Claude/Codex tab, which always carries a
              profile icon, so the header content is inset from the tab's left edge by the icon — the
              overhang extends into that icon gap, not past the tab border. CornerRadius rounds it into
              a pill; the translucent accent fill keeps the title/dot legible on top.  -->
        <Border x:Name="HeaderAgentSelectionPill"
                Margin="-8,-3,-8,-3"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                CornerRadius="8"
                Background="{x:Bind TabStatus.AgentSelectionBrush, Mode=OneWay}"
                Visibility="{x:Bind TabStatus.AgentSelectionVisible, Mode=OneWay}" />
        <StackPanel x:Name="HeaderStackPanel"
                Orientation="Horizontal"
                VerticalAlignment="Center">
        <mux:ProgressRing x:Name="HeaderProgressRing"
                          Width="15"
                          Height="15"
                          MinWidth="0"
                          MinHeight="0"
                          Margin="3,0,8,0"
                          IsActive="{x:Bind TabStatus.IsProgressRingActive, Mode=OneWay}"
                          IsIndeterminate="{x:Bind TabStatus.IsProgressRingIndeterminate, Mode=OneWay}"
                          ToolTipService.ToolTip="A task in this tab is reporting progress."
                          Visibility="{x:Bind TabStatus.IsProgressRingActive, Mode=OneWay}"
                          Value="{x:Bind TabStatus.ProgressValue, Mode=OneWay}" />
        <FontIcon x:Name="HeaderBellIndicator"
                  Margin="0,0,8,0"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="12"
                  Glyph="&#xEA8F;"
                  ToolTipService.ToolTip="This tab rang the bell &#x2014; activity happened while it was in the background."
                  Visibility="{x:Bind TabStatus.BellIndicator, Mode=OneWay}" />
        <FontIcon x:Name="HeaderZoomIcon"
                  Margin="0,0,8,0"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="12"
                  Glyph="&#xE8A3;"
                  ToolTipService.ToolTip="A pane in this tab is zoomed to fill the tab."
                  Visibility="{x:Bind TabStatus.IsPaneZoomed, Mode=OneWay}" />
        <FontIcon x:Name="HeaderLockIcon"
                  Margin="0,0,8,0"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="12"
                  Glyph="&#xE72E;"
                  ToolTipService.ToolTip="This tab is read-only &#x2014; keyboard input is blocked until read-only mode is turned off."
                  Visibility="{x:Bind TabStatus.IsReadOnlyActive, Mode=OneWay}" />
        <FontIcon x:Name="HeaderClosedIcon"
                  Margin="0,0,8,0"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="12"
                  Glyph="&#xEA39;"
                  ToolTipService.ToolTip="The process in this tab has exited; the tab stays open so you can read its output."
                  Visibility="{x:Bind TabStatus.IsConnectionClosed, Mode=OneWay}" />
        <FontIcon x:Name="HeaderBroadcastIcon"
                  Margin="0,0,8,0"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="12"
                  Glyph="&#xEC05;"
                  ToolTipService.ToolTip="Input is being broadcast to every pane in this tab &#x2014; what you type goes to all of them."
                  Visibility="{x:Bind TabStatus.IsInputBroadcastActive, Mode=OneWay}" />
        <!--  Agentmaster: the tab-strip status dot. Sits between the TabViewItem icon (outside this
              control) and the title, so the header reads "[icon] (dot) (title)" — state-colored for a
              managed Claude session (the Triage-Board palette via AgentStatusColors.h), dim gray for
              an observed-only tab; collapsed on anything Agentmaster doesn't classify. An Ellipse
              (originally a "●" TextBlock): a real filled shape renders BOLDER than the glyph's ink at
              the same size, takes a thin BLACK Stroke so the dot
              stays legible on ANY tab background
              (per-dir colored tabs, the selected-tab highlight, light themes), and centers
              deterministically — no font line-box / baseline concerns. The Fill binds the same
              AgentStatusBrush the code already writes, so this is presentation-only. Margin
              "0,1,6,-1": left is 0 — NO negative overhang. A negative left margin (an earlier
              attempt to tighten the icon→dot gap) made the dot hang past the header's left edge
              and get CLIPPED by the tab border on tabs whose content starts near the left (e.g. a
              no-icon shell tab). The icon→dot gap is now tightened the safe way — globally, via a
              TabViewItemHeaderIconMargin override on the TabView (TabRowControl.xaml) — so the dot
              sits close to the icon without any element hanging off the border. Top +1 / bottom -1
              dips the dot 1px below slot-center (dead-center reads optically HIGH against the
              title) while the consumed height stays 10px (no header-row growth).  -->
        <!--  Agentmaster (RED FLASH RING): the status dot wrapped so a red ring can flash AROUND it.
              The wrap Grid is the CONTAINER that bounds every status glyph — anything overflowing it is
              CLIPPED by the tab header (an earlier 10px wrap let the 13px ring overflow and the header
              clipped it to a truncated SQUARE; the edge-clipping the dot comment above warns about), so
              each glyph must FIT INSIDE the glyph row. That row is sized 18px — large enough to contain the 17px
              FAVORITE STAR (FAVORITES.md §5a), comfortably bigger than the 10px dot + the 13px ring. To
              avoid widening the tab strip, the wrap's RIGHT margin is trimmed to 0 so the total
              horizontal footprint (wrap + margin) is unchanged from the prior 14px-wrap + 4px-margin
              (= 18px either way) — the title does NOT shift; only the centred dot sits ~2px further right
              within the slot. 18px stays under the ~19px title line height, so tabs don't grow taller.
              The ring is a 13px red ellipse drawn FIRST (behind), centred with ~2.5px clearance in the
              18px wrap; the 10px dot, centred on top, covers its centre so only a ~1.5px red ring peeks
              out AROUND the dot's black stroke — reading outside-in: red ring, then black stroke, then
              the status-colour fill. The ring shows only while the shared flash timer toggles
              AgentFlashRingVisible (every 600ms) on an unvisited Running->resting tab; the dot's own
              black stroke + status fill never change. IsHitTestVisible=False: decorative.  -->
        <Grid x:Name="HeaderAgentStatusDotWrap"
              Width="18"
              Margin="0,1,0,-1"
              VerticalAlignment="Center">
            <!--  Agentmaster (PENDING_INPUT.md): the wrap is a 2-ROW grid — an 18px GLYPH cell over a
                  4px PENDING-dots band (total 22px). Previously a single fixed 18px Grid that clipped
                  anything below the dot: the favorite STAR fills the 18px cell (its lower points reach
                  wrap-y ~16.5), leaving NO room beneath it, so the pulsing draft "3 dots" overflowed the
                  18px wrap and the tab header clipped them. The band is a FIXED row (not Auto) so the
                  glyph cell never reflows when a draft appears/clears — the status dot stays STATIONARY,
                  the dots merely fade in/out within their reserved band. This is the "stretch the
                  indicator's height so the dots aren't truncated, while the dot stays put" fix. Because
                  the band sits strictly BELOW the glyph cell, the dots clear the star's lower points with
                  no per-favorite vertical offset (the old +3px STAR nudge is gone). 22px stays within the
                  tab's content height, so the strip doesn't grow.  -->
            <Grid.RowDefinitions>
                <!--  Row 0: the status GLYPHS — the children below omit Grid.Row and default here, so
                      the flash ring / favorite star / status dot / dormant half-dot+ring / favorite crown
                      all live in this 18px cell exactly as before (geometry unchanged).  -->
                <RowDefinition Height="18" />
                <!--  Row 1: the reserved 4px band for the pending "3 dots".  -->
                <RowDefinition Height="4" />
            </Grid.RowDefinitions>
            <!--  Agentmaster: the flash ring's Fill is the user-configurable "status flashing color"
                  (Settings cog -> AppSettings.flashRingColor), bound to TabStatus.AgentFlashRingBrush
                  (its alpha channel = the ring opacity). Was a hardcoded Fill="Red"; the brush defaults
                  to fully-opaque red so the look is unchanged until the user picks another color. The
                  brush is set just before AgentFlashRingVisible flips true (single chokepoint
                  _SetTabFlashRing), so the ring is never momentarily shown with a null brush.  -->
            <!--  Agentmaster (SPARK CROWN — the cache-warm hint): the GLOW half. A soft amber halo behind
                  the status dot, shown while TabStatus.AgentCacheWarmVisible (ServerCacheStillWarm — the
                  same predicate behind the Triage-Board card's amber glyph). Drawn FIRST so it sits behind
                  EVERY other glyph: the red flash ring is the louder "needs you" alert and must never be
                  tinted or hidden by a cosmetic cache hint. No gradient brush is used — RadialGradientBrush
                  appears nowhere in this codebase, so the falloff is faked the portable way: TWO concentric
                  flat discs at different opacities (the inner one brighter), giving an outward step-down
                  from the dot's edge that reads as a glow rather than a second hard outline. Both are
                  wrapped in ONE Grid so a SINGLE Opacity animation breathes the whole halo (nested opacity
                  multiplies) instead of one animation per disc. 16px stays inside the 18px cell, so nothing
                  is clipped by the tab header. IsHitTestVisible=False: decorative. Tune knobs: the two
                  Widths/Heights (halo spread), their Opacity ratio (falloff steepness), and the storyboard's
                  Opacity range in TabHeaderControl.cpp (breath depth).  -->
            <Grid x:Name="HeaderCacheWarmGlow"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"
                  Opacity="0.45"
                  Visibility="{x:Bind TabStatus.AgentCacheWarmVisible, Mode=OneWay}">
                <Ellipse Width="16"
                         Height="16"
                         Opacity="0.5"
                         Fill="{x:Bind TabStatus.AgentCacheWarmBrush, Mode=OneWay}" />
                <Ellipse Width="12.5"
                         Height="12.5"
                         Opacity="0.55"
                         Fill="{x:Bind TabStatus.AgentCacheWarmBrush, Mode=OneWay}" />
            </Grid>
            <Ellipse x:Name="HeaderAgentStatusFlashRing"
                     Width="13"
                     Height="13"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     Fill="{x:Bind TabStatus.AgentFlashRingBrush, Mode=OneWay}"
                     Visibility="{x:Bind TabStatus.AgentFlashRingVisible, Mode=OneWay}" />
            <!--  Agentmaster (FAVORITES.md §5a): the STAR favorite marker — the alternative to the crown
                  below, chosen by the GLOBAL AppSettings.favoriteIcon (Crown default / Star). Drawn HERE,
                  BEFORE the status dot, so it sits BEHIND the dot: the state-colored dot becomes the
                  FOREGROUND of a white, golden-tipped star whose points radiate AROUND the dot (the
                  requested look — "the status indicator as a foreground to a white star with golden
                  tips"). A 5-point star Path, white Fill with a gold (#F5C242, the Sessions ★ / crown
                  gold) Stroke whose miter joins make the sharp TIPS read golden; Stretch=Fill centres it
                  on the dot. Kept INSIDE the 18px wrap (overflow is clipped by the tab header) — a 17px
                  box + a thin stroke leaves a sub-pixel margin so the tips aren't clipped. At 17px the
                  points reach ~3.5px beyond the 10px dot (2px further than the prior 13px star, per the
                  request). Mutually exclusive with the crown (TerminalPage::_SetTabAgentFavorite asserts
                  exactly one). IsHitTestVisible=False: decorative. Tune knobs: Width/Height (size relative
                  to the 10px dot; must stay <= the wrap), StrokeThickness (tip gold weight), the Data
                  geometry (star proportions).  -->
            <Path x:Name="HeaderAgentFavoriteStar"
                  Width="17"
                  Height="17"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Stretch="Fill"
                  IsHitTestVisible="False"
                  Data="M7,0 L8.65,4.74 L13.66,4.84 L9.66,7.87 L11.11,12.66 L7,9.8 L2.89,12.66 L4.34,7.87 L0.34,4.84 L5.35,4.74 Z"
                  Fill="White"
                  Stroke="#F5C242"
                  StrokeThickness="0.8"
                  StrokeLineJoin="Miter"
                  Visibility="{x:Bind TabStatus.AgentFavoriteStarVisible, Mode=OneWay}">
                <!--  Nudge the star up 1px (the wrap's Margin dips its content 1px down; this lifts the
                      star back toward optical centre). Safe: the downward dip leaves room above, so the
                      top tip isn't clipped. Tune knob: TranslateTransform.Y.  -->
                <Path.RenderTransform>
                    <TranslateTransform Y="-1" />
                </Path.RenderTransform>
            </Path>
            <Ellipse x:Name="HeaderAgentStatusDot"
                     Width="10"
                     Height="10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="{x:Bind TabStatus.AgentStatusBrush, Mode=OneWay}"
                     Stroke="Black"
                     StrokeThickness="1"
                     Visibility="{x:Bind TabStatus.AgentStatusVisible, Mode=OneWay}" />
            <!--  Agentmaster (eager-init / "Activate Tab"): the DORMANT half-hollow dot — shown INSTEAD of
                  the full dot above when this session is live but its claude hasn't started yet (a window-
                  restored / re-homed tab the user never clicked; ConnectionState == NotConnected). It reads
                  as "not initialized; Activate to wake it". Two elements, both bound to AgentStatusHalfVisible
                  (mutually exclusive with the full dot's AgentStatusVisible — _SetTabAgentDot drives exactly
                  one): a RING (10px ellipse, transparent fill + black stroke) = the full outline / the hollow
                  half; and a HALF-FILL (the same 10px ellipse filled with AgentStatusBrush, CLIPPED to its
                  right half via the RectangleGeometry) = the status-coloured half. Same 10px geometry + black
                  stroke as the full dot, so the dormant<->started swap is seamless. IsHitTestVisible=False:
                  decorative. To flip which half fills, move the clip Rect to the left half (Rect 0,0,5,10).  -->
            <Ellipse x:Name="HeaderAgentStatusDotHalfFill"
                     Width="10"
                     Height="10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     Fill="{x:Bind TabStatus.AgentStatusBrush, Mode=OneWay}"
                     Visibility="{x:Bind TabStatus.AgentStatusHalfVisible, Mode=OneWay}">
                <Ellipse.Clip>
                    <RectangleGeometry Rect="5,0,5,10" />
                </Ellipse.Clip>
            </Ellipse>
            <Ellipse x:Name="HeaderAgentStatusDotRing"
                     Width="10"
                     Height="10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     Fill="Transparent"
                     Stroke="{x:Bind TabStatus.AgentStatusBrush, Mode=OneWay}"
                     StrokeThickness="1"
                     Visibility="{x:Bind TabStatus.AgentStatusHalfVisible, Mode=OneWay}" />
            <!--  Agentmaster (FAVORITES.md): the FAVORITE crown. A small gold crown perched at the
                  NORTH-WEST of the status dot to mark a starred (favorited) session on its LIVE tab —
                  the one visible "keeper" marker on the strip (the Sessions page has its ★ column;
                  the board/tree/overlay had none). Drawn LAST so it sits ON TOP of the dot; Top/Left
                  aligned within the 14px wrap (the gold #F5C242 matches the Sessions ★) and tilted
                  ~-20° so the peak faces NW (head to the upper-left), as requested. Kept INSIDE the
                  14px wrap (the flash-ring comment above: overflow gets clipped by the tab header),
                  so the rendered 8x5 box at margin 1,0 plus the small rotation stays within bounds.
                  IsHitTestVisible=False: decorative, never eats a tab click. Tune knobs: Width/Height
                  (size), RotateTransform.Angle (NW tilt), Margin (NW offset).  -->
            <Path x:Name="HeaderAgentFavoriteCrown"
                  Width="9"
                  Height="6"
                  Margin="1,0,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Stretch="Fill"
                  IsHitTestVisible="False"
                  Data="M0,6 L0,2 L2.7,3.8 L5,0.6 L7.3,3.8 L10,2 L10,6 Z"
                  Fill="#F5C242"
                  Stroke="#4D3A00"
                  StrokeThickness="0.4"
                  Visibility="{x:Bind TabStatus.AgentFavoriteVisible, Mode=OneWay}">
                <Path.RenderTransform>
                    <RotateTransform Angle="-20"
                                     CenterX="4.5"
                                     CenterY="3" />
                </Path.RenderTransform>
            </Path>
            <!--  Agentmaster (SPARK CROWN — the cache-warm hint): the EMBERS half. Three small sparks that
                  rise out of the status dot and fade, staggered, while TabStatus.AgentCacheWarmVisible. The
                  status dot itself is deliberately UNTOUCHED (unlike a flame that would replace it), so the
                  Triage state colour reads exactly as before — the whole point of this design.
                  Drawn LAST, i.e. ON TOP of every other glyph INCLUDING the favourite crown: the crown owns
                  the cell's top-left and the centre spark would otherwise flicker behind it; over it, the
                  embers simply read as sparks coming off the crown. A Canvas (not margins on a Grid) so each
                  spark's position is stated as plain Left/Top instead of an alignment-plus-margin puzzle.
                  Each carries its own TranslateTransform, which the storyboard drives (Y) alongside an
                  opacity keyframe — built + started/stopped in code-behind (_UpdateCacheWarmAnimation), so a
                  fleet whose caches are all cold animates NOTHING. Base Opacity="0" so a spark is invisible
                  until the storyboard actually runs it (a warm tab whose storyboard failed to start shows
                  the glow alone, never three frozen dots). The rise is bounded to keep the visible part
                  inside the 18px cell — anything above it is CLIPPED by the tab header (the same trap that
                  once truncated the 13px flash ring into a square). IsHitTestVisible=False: decorative.
                  Tune knobs: Canvas.Left/Top (the cluster's shape), Width/Height (ember size), and the
                  storyboard's Y range / duration / stagger in TabHeaderControl.cpp.  -->
            <Canvas x:Name="HeaderCacheWarmSparks"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind TabStatus.AgentCacheWarmVisible, Mode=OneWay}">
                <Ellipse x:Name="HeaderCacheSpark0"
                         Canvas.Left="3.8"
                         Canvas.Top="2.8"
                         Width="2.4"
                         Height="2.4"
                         Opacity="0"
                         Fill="{x:Bind TabStatus.AgentCacheWarmBrush, Mode=OneWay}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="HeaderCacheSpark1"
                         Canvas.Left="7.6"
                         Canvas.Top="1.6"
                         Width="2.8"
                         Height="2.8"
                         Opacity="0"
                         Fill="{x:Bind TabStatus.AgentCacheWarmBrush, Mode=OneWay}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="HeaderCacheSpark2"
                         Canvas.Left="11.8"
                         Canvas.Top="2.8"
                         Width="2.4"
                         Height="2.4"
                         Opacity="0"
                         Fill="{x:Bind TabStatus.AgentCacheWarmBrush, Mode=OneWay}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
            <!--  Agentmaster (PENDING_INPUT.md): the UNSENT-DRAFT "3 dots" indicator. When the observer
                  detects text typed but NOT yet submitted in this tab's Claude input box (the debounced
                  SessionInfo.pendingInput -> TabStatus.AgentPendingVisible), a tiny 3-dot cluster pulses
                  at the BOTTOM of the status-dot wrap, just below the dot — a calm "you have a message
                  waiting here" cue. Its color is user-configurable as a LIGHT/DARK pair, contrast-picked
                  from the tab's per-dir color so it's never invisible (TabStatus.AgentPendingBrush, set by
                  TerminalPage::_SetTabPending). The staggered opacity pulse storyboard is BUILT and
                  started/stopped in code-behind (TabHeaderControl.cpp _UpdatePendingAnimation), so it
                  runs ONLY while this tab is actually pending — an idle fleet never holds the compositor
                  at 60fps. The dots are 2.5px on a 1.5px gap (~10px), centred in the reserved Row 1 band
                  (strictly BELOW the 18px glyph cell, so they clear the dot AND the favorite star's lower
                  points without any per-favorite offset). IsHitTestVisible=False: decorative.  -->
            <StackPanel x:Name="HeaderPendingDots"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="1.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind TabStatus.AgentPendingVisible, Mode=OneWay}">
                <Ellipse x:Name="HeaderPendingDot0"
                         Width="2.5"
                         Height="2.5"
                         Fill="{x:Bind TabStatus.AgentPendingBrush, Mode=OneWay}" />
                <Ellipse x:Name="HeaderPendingDot1"
                         Width="2.5"
                         Height="2.5"
                         Fill="{x:Bind TabStatus.AgentPendingBrush, Mode=OneWay}" />
                <Ellipse x:Name="HeaderPendingDot2"
                         Width="2.5"
                         Height="2.5"
                         Fill="{x:Bind TabStatus.AgentPendingBrush, Mode=OneWay}" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="HeaderTextBlock"
                   Text="{x:Bind Title, Mode=OneWay}"
                   Visibility="Visible" />
        <!--  Agentmaster: AcceptsReturn makes this a MULTI-LINE rename box — a non-commit Return inserts
              a newline (titles can hold line breaks). Commit (accept + save, identical to clicking away)
              is by clicking away (LostFocus) ALWAYS, plus optionally Shift+Enter (default) or Enter, per
              the GLOBAL TabRenameCommitMode app-setting — see TabHeaderControl.cpp's PreviewKeyDown/KeyUp,
              which suppress the newline for whichever key is the commit key. Escape cancels.
              TextWrapping is NoWrap (NOT Wrap): this box lives in the tab header's HORIZONTAL
              StackPanel, which measures children with INFINITE width. A Wrap TextBox has no finite
              width to wrap against there, so it degenerates to its MinWidth and never grows with the
              text — in SizeToContent tab mode (RenamerMaxWidth = infinity) it collapsed to ~0px and
              whatever you typed scrolled invisibly inside it (the title still committed on focus-loss,
              you just couldn't see it while typing). NoWrap makes the box auto-size its WIDTH to the
              content in BOTH tab-width modes, so it stays visible and grows as you type; explicit
              Return newlines still grow it vertically up to MaxHeight. MinWidth is a usable floor so
              an emptied box (Ctrl+A, Delete) stays visible instead of vanishing; MinHeight keeps the
              one-line look; MaxHeight caps the growth for a tall title.
              Agentmaster: MaxWidth is set in code-behind (_ApplyRenamerMaxWidth), NOT bound here. The
              box is anchored at the tab's left and grows rightward, so an unbounded (SizeToContent) or
              far-right (equal mode) box could push its RIGHT border off the window edge — and with RTL
              (Hebrew) text, whose start sits at the right edge, you'd lose both the border and the start
              of the title. The code caps MaxWidth to the space from the box's on-screen left to the
              window's right edge (using RenamerMaxWidth as the settings ceiling), so the box grows as
              large as it can while staying fully visible.  -->
        <TextBox x:Name="HeaderRenamerTextBox"
                 MinHeight="24"
                 MaxHeight="96"
                 MinWidth="120"
                 Padding="4,4,4,3"
                 FontSize="12"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 IsSpellCheckEnabled="False"
                 LostFocus="RenameBoxLostFocusHandler"
                 MaxLength="1024"
                 Visibility="Collapsed">
            <TextBox.ContextFlyout>
                <mtu:TextMenuFlyout />
            </TextBox.ContextFlyout>
        </TextBox>
        </StackPanel>
        <!--  Agentmaster (consistent multi-line tab-row height): an invisible height "reserver". The tab
              strip's ListView stretches every tab to the tallest REALIZED tab, so a tab whose title has
              embedded newlines (a multi-line rename) grew the WHOLE row only while it was on-screen —
              scrolling it out (the ListView virtualizes it away) snapped the row shorter, scrolling back
              grew it again. TerminalPage pushes the MAX title-line-count across ALL tabs (visible OR
              scrolled-off) to every header via ReserveTitleLines(); this TextBlock then holds that many
              blank lines so the header ALWAYS measures that tall. It INHERITS the title's font (no explicit
              FontSize/FontFamily, exactly like HeaderTextBlock), so N blank lines == the exact height of an
              N-line title at any DPI/scale — no pixel math. Lives in the Grid (NOT the horizontal
              StackPanel) and its lines are zero-width, so it never shifts the title's x, the status dot, or
              the tag-badge anchor; Collapsed at <=1 line, so a single-line strip is byte-identical to before.
              Transparent + non-hit-test: a pure measuring shim.  -->
        <TextBlock x:Name="HeaderTitleLineReserver"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Foreground="Transparent"
                   TextWrapping="NoWrap"
                   Visibility="Collapsed" />
        <!--  Agentmaster (bookmark tags): one small BOOKMARK ribbon per tag on this session, drawn
              OVERHANGING the tab's bottom edge — ~30% of each ribbon above the tab's bottom line,
              ~70% hanging BELOW it (a bookmark sticking out of the "book"), the row starting at the
              title's FIRST-CHARACTER x. Hosted in an ALWAYS-OPEN PARENTED POPUP because that's the
              only way the overhang can render: in-tree pixels below the tab rectangle are clipped by
              the tab strip's ScrollViewer (its viewport bottom IS the tab's bottom edge), while a
              parented Popup's child renders in the island's POPUP ROOT — outside every clip — at the
              parent's position + offsets (the same raw-parented-Popup pattern the page's tag panels
              use; the codebase's popup crash class was OWNERLESS tooltips, not parented popups).
              Layout-neutral by construction (a closed/open Popup takes no layout space), so however
              many badges show, the tab measures exactly as if they weren't there. Positioning,
              scroll/reorder tracking, and out-of-viewport hiding live in _PositionTagBadges. The
              Polygons are BUILT IN CODE-BEHIND (_UpdateTagBadges) from TabStatus.AgentTagsSpec — tag
              count varies, each badge colored by the spec-carried resolved color — riding the same
              TabStatus PropertyChanged pipeline as the pending-dots animation. Hovering a badge raises
              TagBadgeHoverBegin/End: the PAGE shows the rich tag panel (every session carrying the tag,
              title + status dot, click == jump to its tab) — richer than a ToolTip, which cannot take
              clicks. Hit-test ON for the hover; popup-hosted badges no longer bubble presses to the
              TabViewItem, so a badge Tapped explicitly selects its tab (click-to-switch preserved).  -->
        <Popup x:Name="HeaderTagBookmarksPopup"
               HorizontalAlignment="Left"
               VerticalAlignment="Top">
            <StackPanel x:Name="HeaderTagBookmarks"
                        Orientation="Horizontal"
                        Spacing="2" />
        </Popup>
    </Grid>
</UserControl>
