<UserControl x:Class="TerminalApp.TabHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mtu="using:Microsoft.Terminal.UI"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             MinHeight="16"
             mc:Ignorable="d">

    <Grid HorizontalAlignment="Left">
        <!--  Agentmaster (Linked Lenses): the "selected/active" pill — a filled accent background
              drawn BEHIND the header content (first Grid child, so the icon/dot/title render on top).
              The Grid sizes to the header StackPanel, so the pill wraps the header content exactly.
              Shown ONLY while the Agent Manager tab is active and this session is hovered/selected in
              the Manager — TerminalPage::_SetTabSelectionPill drives AgentSelectionVisible/Brush via
              Tab.TabStatus(). Presentation-only: the Manager tab stays the actually-selected tab, and
              this never touches the per-dir tab color (Rule #12). Margin gives the pill a touch of
              vertical height; NO negative LEFT (a left overhang clips on the tab border — see the dot
              note below).  -->
        <Border x:Name="HeaderAgentSelectionPill"
                Margin="0,-1,0,-1"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                CornerRadius="4"
                Background="{x:Bind TabStatus.AgentSelectionBrush, Mode=OneWay}"
                Visibility="{x:Bind TabStatus.AgentSelectionVisible, Mode=OneWay}" />
        <StackPanel x:Name="HeaderStackPanel"
                Orientation="Horizontal">
        <mux:ProgressRing x:Name="HeaderProgressRing"
                          Width="15"
                          Height="15"
                          MinWidth="0"
                          MinHeight="0"
                          Margin="3,0,8,0"
                          IsActive="{x:Bind TabStatus.IsProgressRingActive, Mode=OneWay}"
                          IsIndeterminate="{x:Bind TabStatus.IsProgressRingIndeterminate, Mode=OneWay}"
                          Visibility="{x:Bind TabStatus.IsProgressRingActive, Mode=OneWay}"
                          Value="{x:Bind TabStatus.ProgressValue, Mode=OneWay}" />
        <FontIcon x:Name="HeaderBellIndicator"
                  Margin="0,0,8,0"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="12"
                  Glyph="&#xEA8F;"
                  Visibility="{x:Bind TabStatus.BellIndicator, Mode=OneWay}" />
        <FontIcon x:Name="HeaderZoomIcon"
                  Margin="0,0,8,0"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="12"
                  Glyph="&#xE8A3;"
                  Visibility="{x:Bind TabStatus.IsPaneZoomed, Mode=OneWay}" />
        <FontIcon x:Name="HeaderLockIcon"
                  Margin="0,0,8,0"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="12"
                  Glyph="&#xE72E;"
                  Visibility="{x:Bind TabStatus.IsReadOnlyActive, Mode=OneWay}" />
        <FontIcon x:Name="HeaderClosedIcon"
                  Margin="0,0,8,0"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="12"
                  Glyph="&#xEA39;"
                  Visibility="{x:Bind TabStatus.IsConnectionClosed, Mode=OneWay}" />
        <FontIcon x:Name="HeaderBroadcastIcon"
                  Margin="0,0,8,0"
                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="12"
                  Glyph="&#xEC05;"
                  Visibility="{x:Bind TabStatus.IsInputBroadcastActive, Mode=OneWay}" />
        <!--  Agentmaster: the tab-strip status dot. Sits between the TabViewItem icon (outside this
              control) and the title, so the header reads "[icon] (dot) (title)" — state-colored for a
              managed Claude session (the Triage-Board palette via AgentStatusColors.h), dim gray for
              an observed-only tab; collapsed on anything Agentmaster doesn't classify. An Ellipse
              (originally a "●" TextBlock): a real filled shape renders BOLDER than the glyph's ink at
              the same size, takes a thin black Stroke so the dot stays legible on ANY tab background
              (per-dir colored tabs, the selected-tab highlight, light themes), and centers
              deterministically — no font line-box / baseline concerns. The Fill binds the same
              AgentStatusBrush the code already writes, so this is presentation-only. Margin
              "0,1,6,-1": left is 0 — NO negative overhang. A negative left margin (an earlier
              attempt to tighten the icon→dot gap) made the dot hang past the header's left edge
              and get CLIPPED by the tab border on tabs whose content starts near the left (e.g. a
              no-icon shell tab). The icon→dot gap is now tightened the safe way — globally, via a
              TabViewItemHeaderIconMargin override on the TabView (TabRowControl.xaml) — so the dot
              sits close to the icon without any element hanging off the border. Top +1 / bottom -1
              dips the dot 1px below slot-center (dead-center reads optically HIGH against the
              title) while the consumed height stays 10px (no header-row growth).  -->
        <Ellipse x:Name="HeaderAgentStatusDot"
                 Width="10"
                 Height="10"
                 Margin="0,1,6,-1"
                 VerticalAlignment="Center"
                 Fill="{x:Bind TabStatus.AgentStatusBrush, Mode=OneWay}"
                 Stroke="Black"
                 StrokeThickness="1"
                 Visibility="{x:Bind TabStatus.AgentStatusVisible, Mode=OneWay}" />
        <TextBlock x:Name="HeaderTextBlock"
                   Text="{x:Bind Title, Mode=OneWay}"
                   Visibility="Visible" />
        <!--  Agentmaster: AcceptsReturn makes this a MULTI-LINE rename box — a non-commit Return inserts
              a newline (titles can hold line breaks). Commit (accept + save, identical to clicking away)
              is by clicking away (LostFocus) ALWAYS, plus optionally Shift+Enter (default) or Enter, per
              the GLOBAL TabRenameCommitMode app-setting — see TabHeaderControl.cpp's PreviewKeyDown/KeyUp,
              which suppress the newline for whichever key is the commit key. Escape cancels.
              TextWrapping is NoWrap (NOT Wrap): this box lives in the tab header's HORIZONTAL
              StackPanel, which measures children with INFINITE width. A Wrap TextBox has no finite
              width to wrap against there, so it degenerates to its MinWidth and never grows with the
              text — in SizeToContent tab mode (RenamerMaxWidth = infinity) it collapsed to ~0px and
              whatever you typed scrolled invisibly inside it (the title still committed on focus-loss,
              you just couldn't see it while typing). NoWrap makes the box auto-size its WIDTH to the
              content in BOTH tab-width modes, so it stays visible and grows as you type; explicit
              Return newlines still grow it vertically up to MaxHeight. MinWidth is a usable floor so
              an emptied box (Ctrl+A, Delete) stays visible instead of vanishing; MinHeight keeps the
              one-line look; MaxHeight caps the growth for a tall title.  -->
        <TextBox x:Name="HeaderRenamerTextBox"
                 MinHeight="24"
                 MaxHeight="96"
                 MinWidth="120"
                 MaxWidth="{x:Bind RenamerMaxWidth, Mode=OneWay}"
                 Padding="4,4,4,3"
                 FontSize="12"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 IsSpellCheckEnabled="False"
                 LostFocus="RenameBoxLostFocusHandler"
                 MaxLength="1024"
                 Visibility="Collapsed">
            <TextBox.ContextFlyout>
                <mtu:TextMenuFlyout />
            </TextBox.ContextFlyout>
        </TextBox>
        </StackPanel>
    </Grid>
</UserControl>
