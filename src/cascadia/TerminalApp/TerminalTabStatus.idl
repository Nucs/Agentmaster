namespace TerminalApp
{
    [default_interface] runtimeclass TerminalTabStatus : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        TerminalTabStatus();

        Boolean IsConnectionClosed { get; set; };
        Boolean IsPaneZoomed { get; set; };
        Boolean IsProgressRingActive { get; set; };
        Boolean IsProgressRingIndeterminate { get; set; };
        Boolean BellIndicator { get; set; };
        UInt32 ProgressValue { get; set; };
        Boolean IsReadOnlyActive { get; set; };
        Boolean IsInputBroadcastActive { get; set; };
        Windows.UI.Color TabColorIndicator { get; set; };

        // Agentmaster: the tab-strip status dot ("[icon] ● <title>", bound by TabHeaderControl.xaml)
        // — state-colored for a managed Claude session (the Triage-Board palette), dim gray for an
        // observed-only tab. Hidden (the default) on tabs Agentmaster doesn't classify.
        Boolean AgentStatusVisible { get; set; };
        Windows.UI.Xaml.Media.Brush AgentStatusBrush { get; set; };

        // Agentmaster (status-dot OUTLINE): the dot's Stroke brush. Normally black (a thin contrast
        // ring, set by TerminalPage::_SetTabAgentDot the first time the dot shows). When a hosted
        // session goes from Running to a resting state (Idle / WaitingForInput / NeedsApproval) while
        // its tab is unvisited, TerminalPage's shared flash timer drives this between red and black
        // every 600ms so the dot's outline blinks red for attention.
        Windows.UI.Xaml.Media.Brush AgentStatusStrokeBrush { get; set; };

        // Agentmaster (Linked Lenses): the "selected/active" pill — a filled accent background drawn
        // BEHIND the tab header (bound by TabHeaderControl.xaml), shown ONLY while the Agent Manager
        // tab is active and this session is hovered/selected in the Manager (TerminalPage drives it
        // via Tab.TabStatus()). Presentation-only — it makes the session's tab read as the active tab
        // without changing the real TabView selection or the per-dir tab color.
        Boolean AgentSelectionVisible { get; set; };
        Windows.UI.Xaml.Media.Brush AgentSelectionBrush { get; set; };
    }
}
