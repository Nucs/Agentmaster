namespace TerminalApp
{
    [default_interface] runtimeclass TerminalTabStatus : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        TerminalTabStatus();

        Boolean IsConnectionClosed { get; set; };
        Boolean IsPaneZoomed { get; set; };
        Boolean IsProgressRingActive { get; set; };
        Boolean IsProgressRingIndeterminate { get; set; };
        Boolean BellIndicator { get; set; };
        UInt32 ProgressValue { get; set; };
        Boolean IsReadOnlyActive { get; set; };
        Boolean IsInputBroadcastActive { get; set; };
        Windows.UI.Color TabColorIndicator { get; set; };

        // Agentmaster: the tab-strip status dot ("[icon] ● <title>", bound by TabHeaderControl.xaml)
        // — state-colored for a managed Claude session (the Triage-Board palette), dim gray for an
        // observed-only tab. Hidden (the default) on tabs Agentmaster doesn't classify.
        Boolean AgentStatusVisible { get; set; };
        Windows.UI.Xaml.Media.Brush AgentStatusBrush { get; set; };

        // Agentmaster (eager-init / "Activate Tab"): the DORMANT half-hollow variant of the status dot —
        // one half AgentStatusBrush, one half hollow (outline only) — shown for a live-but-not-yet-started
        // (ConnectionState::NotConnected) managed tab. Mutually exclusive with AgentStatusVisible (the full
        // dot); _SetTabAgentDot drives exactly one. Shares AgentStatusBrush.
        Boolean AgentStatusHalfVisible { get; set; };

        // Agentmaster (status-dot RED FLASH RING): when a hosted session goes from Running to a resting
        // state (Idle / WaitingForInput / NeedsApproval) while its tab is unvisited, TerminalPage's
        // shared 600ms timer toggles this so a RING — a separate ellipse drawn BEHIND the dot, its
        // edge peeking out AROUND the dot's black outline — blinks on and off for attention. The dot
        // itself keeps its constant black outline + status-colour fill; only the ring flashes.
        Boolean AgentFlashRingVisible { get; set; };

        // Agentmaster (status-dot flash-ring COLOR): the brush the flash ring is painted with — the
        // user-configurable "status flashing color" (Settings cog), GLOBAL across windows. Its alpha
        // channel carries the ring's OPACITY (the cog's color picker has its alpha slider enabled), so
        // a translucent ring is just a brush whose Color.A < 0xFF. TerminalPage drives this via
        // Tab.TabStatus() from AppSettings::flashRingColor (default fully-opaque red, == the prior
        // hardcoded Fill="Red"); all flashing tabs in a window share ONE brush instance, so a settings
        // change re-points every ring at once. Null until the tab first flashes (the ring is collapsed
        // until then, so the null brush is never seen).
        Windows.UI.Xaml.Media.Brush AgentFlashRingBrush { get; set; };

        // Agentmaster (Linked Lenses): the "selected/active" pill — a filled accent background drawn
        // BEHIND the tab header (bound by TabHeaderControl.xaml), shown ONLY while the Agent Manager
        // tab is active and this session is hovered/selected in the Manager (TerminalPage drives it
        // via Tab.TabStatus()). Presentation-only — it makes the session's tab read as the active tab
        // without changing the real TabView selection or the per-dir tab color.
        Boolean AgentSelectionVisible { get; set; };
        Windows.UI.Xaml.Media.Brush AgentSelectionBrush { get; set; };

        // Agentmaster (FAVORITES.md §5a): the FAVORITE marker over the status dot (bound by
        // TabHeaderControl.xaml), shown when the hosted session is starred (the durable SessionStore
        // "favorite" key) — the one visible "this is a keeper" marker on a LIVE session's tab.
        // TerminalPage drives these via Tab.TabStatus() from the GLOBAL AppSettings::favoriteIcon, and
        // they are mutually exclusive (at most one true at a time): AgentFavoriteVisible == the CROWN
        // (a gold crown at the dot's north-west, the default); AgentFavoriteStarVisible == the STAR
        // (a white, golden-tipped star drawn BEHIND the dot, the status dot as its foreground).
        Boolean AgentFavoriteVisible { get; set; };
        Boolean AgentFavoriteStarVisible { get; set; };

        // Agentmaster (PENDING_INPUT.md): the UNSENT-DRAFT indicator — true when the Fleet Observer
        // detects the user has typed but not yet submitted a message in this tab's Claude input box
        // (the debounced SessionInfo::pendingInput). TabHeaderControl.xaml shows a small animated "3
        // dots" cluster pulsing below the status dot; driven by TerminalPage::_SetTabPending via
        // Tab.TabStatus(). Collapsed (the default) when there is no draft.
        Boolean AgentPendingVisible { get; set; };

        // Agentmaster (PENDING_INPUT.md): the brush the "3 dots" are painted with — the user-configurable
        // pending-dots color, picked LIGHT-on-dark / DARK-on-light from the session's per-directory tab
        // color so the dots are never invisible (AppSettings::pendingDotsLightColor / pendingDotsDarkColor
        // via PendingDotsColorFor). TerminalPage::_SetTabPending sets it just before AgentPendingVisible
        // flips true, so the dots are never momentarily shown with a null/stale brush. Null until the tab
        // first shows a draft (the dots are collapsed until then). Replaces the previously hardcoded
        // Fill="#E0A92B".
        Windows.UI.Xaml.Media.Brush AgentPendingBrush { get; set; };

        // Agentmaster (bookmark tags): the session's tag list for the tab-strip BOOKMARK badges —
        // '\n'-joined "name\t#AARRGGBB" lines (NormalizeTagName strips control chars from names, so
        // both separators are unambiguous; "" == no tags). The COLOR rides the spec: the producer
        // (TerminalPage::_SetTabAgentTags) resolves each tag's display color ONCE (the user-picked
        // tag-colors.json entry, else the stable name-hash TagColorFor), so every consumer renders
        // the same resolution with no store I/O. A SPEC STRING rather than a vector so it rides the
        // same ONE observable-property pipeline the pending-dots animation uses: the producer writes
        // it (idempotent — the observable no-ops when unchanged), TabHeaderControl's code-behind
        // rebuilds one small bookmark ribbon per tag, and the rich tab tooltip renders its tag-chip
        // row (name over a colored underscore) from the same string.
        String AgentTagsSpec { get; set; };
    }
}
