<ContentPresenter x:Class="TerminalApp.TabRowControl"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="using:TerminalApp"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:mux="using:Microsoft.UI.Xaml.Controls"
                  Background="{ThemeResource TabViewBackground}"
                  mc:Ignorable="d">

    <!--
        GH#13143: Make sure that the Background is actually TabViewBackground
        here, not Transparent. This is load bearing, for showTabsInTitlebar=false.
    -->

    <!--
        Set the padding to -1 on the bottom. This prevents a small 1px gap that
        can appear on 150% scale displays between the tab item and the content.
        The 1 on top helps keep the tab the correct relative height within the
        tab row.
    -->

    <!--
        Agentmaster: CanDragTabs/CanReorderTabs are FALSE — native MUX tab drag is permanently
        disabled (TabView::FindTabViewItemFromDragItem null-derefs on virtualized-out containers
        at drag-start AND drop; see the CLAUDE.md "MUX TabView drag-start null-deref" gotcha).
        TerminalPage::Create() re-asserts both; drag reorder/tear-out are re-implemented as the
        pointer-owned gesture (TerminalPage::_WireTabReorderGesture).
    -->
    <mux:TabView x:Name="TabView"
                 VerticalAlignment="Bottom"
                 HorizontalContentAlignment="Stretch"
                 AllowDropTabs="True"
                 Background="Transparent"
                 CanDragTabs="False"
                 CanReorderTabs="False"
                 IsAddTabButtonVisible="false"
                 TabWidthMode="Equal">

        <!--  Agentmaster: tighten the icon → header gap from the MUX default 10px to 4px, so the
              tab-strip status dot / title sit closer to the profile icon. This is the SAFE way to
              get "less space left of the dot" — it replaces a negative dot margin that overhung and
              got clipped at the tab's left border (see TabHeaderControl.xaml). Scoped to the TabView
              so every TabViewItem resolves it; applies uniformly to all tabs.  -->
        <mux:TabView.Resources>
            <Thickness x:Key="TabViewItemHeaderIconMargin">0,0,4,0</Thickness>
        </mux:TabView.Resources>

        <mux:TabView.TabStripHeader>
            <!--  Agentmaster: the strip header sits in the TabView's LeftContentColumn — immediately
                  to the LEFT of the `<` scroll arrow. It hosts the existing elevation shield AND the
                  "Home" button — the Agent Manager's place in the strip now that the Manager is a page,
                  not a tab: always shown (TerminalPage::_UpdateManagerNavButtons) and the ONLY way to
                  open the Agent Manager page; it paints as the active tab while the page is up, and on
                  the page it turns into the jump-back arrow (one button, two faces — there is no
                  separate Jump Back button any more).  -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Stretch">
                <!--  EA18 is the "Shield" glyph  -->
                <FontIcon x:Uid="ElevationShield"
                          Margin="9,4,0,4"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="16"
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                          Glyph="&#xEA18;"
                          Visibility="{x:Bind ShowElevationShield, Mode=OneWay}" />

                <!--  Agentmaster: the Agent Manager's button, with TWO FACES (TerminalPage::
                      _ApplyManagerHomeButtonFace). Off the page it is HOME (E80F = the "Home" glyph): a click
                      opens the Agent Manager page. On the page, while a session of this window is selected in
                      the Manager, it turns into the JUMP-BACK arrow (E7A7 = the "Undo" glyph — the arrow the
                      separate Jump Back button wore until 2026-10-12): a click returns to that session's tab.
                      Collapsed here until the window's Agent Manager page exists (TerminalPage shows it then,
                      for good), and TerminalPage wires the Click (like the New Tab button, in C++) — not here.
                      Flat/transparent so it reads as part of the tab strip beside the scroll arrows;
                      sized/aligned to match the New Tab button. While the page is on screen TerminalPage paints
                      its Background with the accent "selected" tint (the tabs are deselected then), in both faces.
                      ⚠ The glyph is flipped through the button's Content, so the FontIcon must stay its DIRECT
                      Content. The tooltip is set from C++ (AgentSetTip — its text follows the face and names the
                      session a click returns to); never add a ToolTipService.ToolTip here: the shared tip's open
                      and close REPLACE and then CLEAR whatever tooltip the button carries.  -->
                <Button x:Name="ManagerHomeButton"
                        Height="24"
                        MinWidth="0"
                        Margin="2,4,2,4"
                        Padding="8,0"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Agent Manager"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Visibility="Collapsed">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14"
                              Glyph="&#xE80F;" />
                </Button>
            </StackPanel>
        </mux:TabView.TabStripHeader>

        <mux:TabView.TabStripFooter>
            <Grid>
                <!--  Remove this border after WinUI 2.8  -->
                <Border Height="1"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!--
                    Agentmaster (TAB_STRIP.md "Auto-hiding the tab row"): "+" and the ▾ menu button sit side by side in this
                    horizontal panel, left-aligned over the footer's bottom line like "+" alone was.
                -->
                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Orientation="Horizontal">
                    <mux:SplitButton x:Name="NewTabButton"
                                     x:Uid="NewTabSplitButton"
                                     Height="24"
                                     Margin="0,4"
                                     Padding="0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Stretch"
                                     AllowDrop="True"
                                     AutomationProperties.AccessibilityView="Control"
                                     BorderThickness="0"
                                     Click="OnNewTabButtonClick"
                                     Content="&#xE710;"
                                     DragOver="OnNewTabButtonDragOver"
                                     Drop="OnNewTabButtonDrop"
                                     FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                     FontSize="12">
                        <!--
                            Agentmaster (TAB_STRIP.md "The + button: the launcher", the user's picks of 2026-11-14 - "One + panel,
                            no ▾"): "+" opens Agentmaster's launcher card (TerminalPage::_LauncherOpenFromTabStrip), so the split
                            button shows "+" ALONE - its ▾ part is sized to nothing and its divider is transparent (the resources
                            below). The control stays a SplitButton, so Windows Terminal's own code that themes it, attaches the
                            profile flyout and reads it keeps working unchanged. No XAML tooltip: TerminalPage sets an
                            Agentmaster one from code (AgentSetTitledTip), and a XAML ToolTip here would be replaced and then
                            cleared by it.
                        -->
                        <!--  U+E710 is the fancy plus icon.  -->
                        <mux:SplitButton.Resources>
                            <!--  Override the SplitButton* resources to match the tab view's button's styles.  -->
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <!--  Agentmaster: no divider - the ▾ part beside "+" is gone (see above).  -->
                                        <SolidColorBrush x:Key="SplitButtonBorderBrushDivider"
                                                         Color="Transparent" />
                                        <StaticResource x:Key="SplitButtonBackground"
                                                        ResourceKey="TabViewButtonBackground" />
                                        <StaticResource x:Key="SplitButtonForeground"
                                                        ResourceKey="TabViewButtonForeground" />
                                        <StaticResource x:Key="SplitButtonBackgroundPressed"
                                                        ResourceKey="TabViewButtonBackgroundPressed" />
                                        <StaticResource x:Key="SplitButtonForegroundPressed"
                                                        ResourceKey="TabViewButtonForegroundPressed" />
                                        <StaticResource x:Key="SplitButtonBackgroundPointerOver"
                                                        ResourceKey="TabViewButtonBackgroundPointerOver" />
                                        <StaticResource x:Key="SplitButtonForegroundPointerOver"
                                                        ResourceKey="TabViewButtonForegroundPointerOver" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <!--  Agentmaster: no divider - the ▾ part beside "+" is gone (see above).  -->
                                        <SolidColorBrush x:Key="SplitButtonBorderBrushDivider"
                                                         Color="Transparent" />
                                        <StaticResource x:Key="SplitButtonBackground"
                                                        ResourceKey="TabViewButtonBackground" />
                                        <StaticResource x:Key="SplitButtonForeground"
                                                        ResourceKey="TabViewButtonForeground" />
                                        <StaticResource x:Key="SplitButtonBackgroundPressed"
                                                        ResourceKey="TabViewButtonBackgroundPressed" />
                                        <StaticResource x:Key="SplitButtonForegroundPressed"
                                                        ResourceKey="TabViewButtonForegroundPressed" />
                                        <StaticResource x:Key="SplitButtonBackgroundPointerOver"
                                                        ResourceKey="TabViewButtonBackgroundPointerOver" />
                                        <StaticResource x:Key="SplitButtonForegroundPointerOver"
                                                        ResourceKey="TabViewButtonForegroundPointerOver" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <!--  Agentmaster: no divider - the ▾ part beside "+" is gone (see above).  -->
                                        <SolidColorBrush x:Key="SplitButtonBorderBrushDivider"
                                                         Color="Transparent" />
                                        <StaticResource x:Key="SplitButtonBackground"
                                                        ResourceKey="TabViewButtonBackground" />
                                        <StaticResource x:Key="SplitButtonForeground"
                                                        ResourceKey="TabViewButtonForeground" />
                                        <StaticResource x:Key="SplitButtonBackgroundPressed"
                                                        ResourceKey="TabViewButtonBackgroundPressed" />
                                        <StaticResource x:Key="SplitButtonForegroundPressed"
                                                        ResourceKey="TabViewButtonForegroundPressed" />
                                        <StaticResource x:Key="SplitButtonBackgroundPointerOver"
                                                        ResourceKey="TabViewButtonBackgroundPointerOver" />
                                        <StaticResource x:Key="SplitButtonForegroundPointerOver"
                                                        ResourceKey="TabViewButtonForegroundPointerOver" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                                <x:Double x:Key="SplitButtonPrimaryButtonSize">31</x:Double>
                                <!--  Agentmaster: 0 (was 31) - the ▾ part takes no room and gets no click; "+" alone opens the launcher.  -->
                                <x:Double x:Key="SplitButtonSecondaryButtonSize">0</x:Double>
                            </ResourceDictionary>
                        </mux:SplitButton.Resources>
                    </mux:SplitButton>

                    <!--
                        Agentmaster (TAB_STRIP.md "Auto-hiding the tab row"; the user's pick of 2026-11-15, "▾ beside + again"): the
                        ▾ MENU BUTTON. Not the SplitButton's old ▾ part (that stays sized to nothing: "+" opens the launcher) but a
                        plain Button whose MenuFlyout TerminalPage attaches and fills at every open (_TabRowMenuDecorate /
                        _TabRowMenuFill): Auto-hide the tab row (checked while the setting is on), Sessions..., Agentmaster settings,
                        Windows Terminal (Settings, Command palette, About). It wears the old ▾'s look: the TabView button colors
                        (the resources below, the SplitButton's own mapping) and the SplitButton template's fallback chevron
                        (E96E ChevronDownSmall at 8). No XAML tooltip and no AutomationId here: TerminalPage sets both from code
                        (AgentSetTitledTip would replace and then clear a XAML tooltip; the id is am.strip.menu).
                    -->
                    <Button x:Name="TabRowMenuButton"
                            Width="26"
                            Height="24"
                            MinWidth="0"
                            Margin="0,4"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="Tab row menu"
                            BorderThickness="0">
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="ButtonBackground"
                                                        ResourceKey="TabViewButtonBackground" />
                                        <StaticResource x:Key="ButtonForeground"
                                                        ResourceKey="TabViewButtonForeground" />
                                        <StaticResource x:Key="ButtonBackgroundPressed"
                                                        ResourceKey="TabViewButtonBackgroundPressed" />
                                        <StaticResource x:Key="ButtonForegroundPressed"
                                                        ResourceKey="TabViewButtonForegroundPressed" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver"
                                                        ResourceKey="TabViewButtonBackgroundPointerOver" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver"
                                                        ResourceKey="TabViewButtonForegroundPointerOver" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <StaticResource x:Key="ButtonBackground"
                                                        ResourceKey="TabViewButtonBackground" />
                                        <StaticResource x:Key="ButtonForeground"
                                                        ResourceKey="TabViewButtonForeground" />
                                        <StaticResource x:Key="ButtonBackgroundPressed"
                                                        ResourceKey="TabViewButtonBackgroundPressed" />
                                        <StaticResource x:Key="ButtonForegroundPressed"
                                                        ResourceKey="TabViewButtonForegroundPressed" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver"
                                                        ResourceKey="TabViewButtonBackgroundPointerOver" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver"
                                                        ResourceKey="TabViewButtonForegroundPointerOver" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <StaticResource x:Key="ButtonBackground"
                                                        ResourceKey="TabViewButtonBackground" />
                                        <StaticResource x:Key="ButtonForeground"
                                                        ResourceKey="TabViewButtonForeground" />
                                        <StaticResource x:Key="ButtonBackgroundPressed"
                                                        ResourceKey="TabViewButtonBackgroundPressed" />
                                        <StaticResource x:Key="ButtonForegroundPressed"
                                                        ResourceKey="TabViewButtonForegroundPressed" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver"
                                                        ResourceKey="TabViewButtonBackgroundPointerOver" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver"
                                                        ResourceKey="TabViewButtonForegroundPointerOver" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="8"
                                  Glyph="&#xE96E;"
                                  IsTextScaleFactorEnabled="False" />
                    </Button>
                </StackPanel>
            </Grid>
        </mux:TabView.TabStripFooter>

    </mux:TabView>

</ContentPresenter>
