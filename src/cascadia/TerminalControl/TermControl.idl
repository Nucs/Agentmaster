import "IKeyBindings.idl";
import "IMouseWheelListener.idl";
import "IControlSettings.idl";
import "ControlInteractivity.idl";
import "EventArgs.idl";
import "ICoreState.idl";
import "ControlCore.idl";

namespace Microsoft.Terminal.Control
{
    // This matches the definition in M.T.UI.
    // Having it here prevents us from having to refer to M.T.UI in **all consuming projects**.
    // WinRT is a trip.
    [uuid("0ddf4edc-3fda-4dee-97ca-a417ee3dd510")]
    interface IDirectKeyListener {
        Boolean OnDirectKeyEvent(UInt32 vkey, UInt8 scanCode, Boolean down);
    }

    enum CursorDisplayState
    {
        Default,
        Shown
    };

    [default_interface] runtimeclass TermControl : Windows.UI.Xaml.Controls.UserControl,
                                                   IDirectKeyListener,
                                                   IMouseWheelListener,
                                                   ICoreState,
                                                   Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        TermControl(ControlInteractivity content);

        TermControl(IControlSettings settings,
                    IControlAppearance unfocusedAppearance,
                    Microsoft.Terminal.TerminalConnection.ITerminalConnection connection);

        static TermControl NewControlByAttachingContent(ControlInteractivity content);

        // Agentmaster (RENDERING.md — the "Software rendering" setting): force EVERY terminal in this
        // process to draw on the CPU (WARP) instead of the GPU, OR'ed with the profile's own
        // `rendering.software`. Process-wide (all windows share one Control DLL); new terminals pick it
        // up when they initialize, existing ones only after ReapplySoftwareRendering(). Any thread.
        static void SetSoftwareRenderingOverride(Boolean enabled);

        static Windows.Foundation.Size GetProposedDimensions(IControlSettings settings,
                                                             UInt32 dpi,
                                                             Int32 commandlineCols,
                                                             Int32 commandlineRows);

        // Agentmaster (RENDERING.md §4c, "Hidden tabs"): the process-wide policy for terminals that
        // are off screen (a tab that is not selected, a pane hidden by zoom, a minimized window).
        // pauseHidden: true = a hidden terminal draws no frames. releaseDelayMs: how long it stays
        // hidden before its renderer gives back the GPU device + swap chain (rebuilt on show, ~0.1 s);
        // 0xFFFFFFFF = never, 0 = at once. Declared LAST among the statics so no existing static
        // changes its slot. Terminals adopt it on their next visibility change, or at once through
        // ReapplyHiddenRenderingPolicy(). Any thread.
        // WARNING: do not rename this to Set<X>. On a XAML type such as TermControl, the XAML compiler
        // reads a two-parameter static Set<X>(a, b) as the setter of an ATTACHED PROPERTY <X>. With no
        // element target it writes SetAttachableMember_<X><TermControl, ..., ::winrt::System::Void> into
        // XamlTypeInfo.g.cpp, and that file does not compile (C3083 / C2039 / C2737). The first name of
        // this member, SetHiddenRenderingPolicy, did exactly that (the 2026-10-03 dev build).
        static void ConfigureHiddenRenderingPolicy(Boolean pauseHidden, UInt32 releaseDelayMs);

        void UpdateControlSettings(IControlSettings settings);
        void UpdateControlSettings(IControlSettings settings, IControlAppearance unfocusedAppearance);

        void ApplyPreviewColorScheme(Microsoft.Terminal.Core.ICoreScheme scheme);
        void ResetPreviewColorScheme();

        void SetOverrideColorScheme(Microsoft.Terminal.Core.ICoreScheme scheme);

        Microsoft.Terminal.TerminalConnection.ITerminalConnection Connection;
        void HardResetWithoutErase();

        UInt64 ContentId{ get; };

        Microsoft.Terminal.Control.IControlSettings Settings { get; };

        // MIDL 3 does not support setter-only properties.
        void KeyBindings(Microsoft.Terminal.Control.IKeyBindings KeyBindings);

        event Windows.Foundation.TypedEventHandler<Object, TitleChangedEventArgs> TitleChanged;
        event Windows.Foundation.TypedEventHandler<Object, WriteToClipboardEventArgs> WriteToClipboard;
        event Windows.Foundation.TypedEventHandler<Object, PasteFromClipboardEventArgs> PasteFromClipboard;
        event Windows.Foundation.TypedEventHandler<Object, OpenHyperlinkEventArgs> OpenHyperlink;
        event Windows.Foundation.TypedEventHandler<Object, Object> SetTaskbarProgress;
        event Windows.Foundation.TypedEventHandler<Object, NoticeEventArgs> RaiseNotice;
        event Windows.Foundation.TypedEventHandler<Object, Object> WarningBell;
        event Windows.Foundation.TypedEventHandler<Object, Object> HidePointerCursor;
        event Windows.Foundation.TypedEventHandler<Object, Object> RestorePointerCursor;
        event Windows.Foundation.TypedEventHandler<Object, Object> TabColorChanged;
        event Windows.Foundation.TypedEventHandler<Object, Object> ReadOnlyChanged;
        event Windows.Foundation.TypedEventHandler<Object, Object> FocusFollowMouseRequested;
        event Windows.Foundation.TypedEventHandler<Object, WindowSizeChangedEventArgs> WindowSizeChanged;

        event Windows.Foundation.TypedEventHandler<Object, CompletionsChangedEventArgs> CompletionsChanged;

        event Windows.Foundation.TypedEventHandler<Object, KeySentEventArgs> KeySent;
        event Windows.Foundation.TypedEventHandler<Object, CharSentEventArgs> CharSent;
        event Windows.Foundation.TypedEventHandler<Object, StringSentEventArgs> StringSent;
        event Windows.Foundation.TypedEventHandler<Object, SearchMissingCommandEventArgs> SearchMissingCommand;


        Microsoft.UI.Xaml.Controls.CommandBarFlyout ContextMenu { get; };
        Microsoft.UI.Xaml.Controls.CommandBarFlyout SelectionContextMenu { get; };
        Windows.UI.Xaml.Controls.MenuFlyout QuickFixMenu { get; };

        event Windows.Foundation.TypedEventHandler<TermControl, Windows.UI.Xaml.RoutedEventArgs> Initialized;
        // This is an event handler forwarder for the underlying connection.
        // We expose this and ConnectionState here so that it might eventually be data bound.
        event Windows.Foundation.TypedEventHandler<Object, IInspectable> ConnectionStateChanged;

        event Windows.Foundation.TypedEventHandler<Object, ShowWindowArgs> ShowWindowChanged;

        event Windows.Foundation.TypedEventHandler<Object, Object> CloseTerminalRequested;
        event Windows.Foundation.TypedEventHandler<Object, Object> RestartTerminalRequested;

        Boolean CopySelectionToClipboard(Boolean dismissSelection, Boolean singleLine, Boolean withControlSequences, CopyFormat formats);
        void PasteTextFromClipboard();
        void SelectAll();
        Boolean ToggleBlockSelection();
        void ToggleMarkMode();
        Boolean SwitchSelectionEndpoint();
        Boolean ExpandSelectionToWord();
        void ClearBuffer(ClearBufferType clearType);
        void RestoreFromPath(String path);
        void PersistTo(Int64 handle);
        void OpenCWD();
        void Close();

        // Agentmaster (eager-init): initialize the terminal + START its connection RIGHT NOW with an
        // explicit size, instead of waiting for the SwapChainPanel's first non-zero layout (which only
        // fires when the tab is first SHOWN). A WT background/restored tab is off the visual tree, so it
        // never gets that layout and its claude.exe never spawns until clicked. This lets the app start a
        // dormant tab IN PLACE (no focus change) — the "Activate Tab" / "Activate All Tabs" actions. The
        // AV-safe Initialize()->Start() order is preserved (output can only reach the buffer after it is
        // built); the supplied size is a placeholder that self-corrects via _SwapChainSizeChanged when the
        // tab is eventually laid out. Returns true if it initialized (false if already initialized or the
        // size is non-positive). UI thread only.
        Boolean InitializeWithSize(Double width, Double height, Single scale);

        // Agentmaster (deactivate/reactivate): START an ALREADY-INITIALIZED control's parked,
        // not-started connection — a shape the lazy layout-init can never start (it is one-shot and
        // already spent) and InitializeWithSize refuses (the core is built). "Deactivate Tab" used to
        // create that shape (it swapped a never-started resume connection into the running control);
        // it now puts a NEVER-INITIALIZED control in the pane instead (a window-restored tab's state,
        // started by its first layout), so this stays only as the app's belt for any control parked
        // that way (TerminalPage::_WakeDeactivatedTab / _ActivateDormantSession). Start() here is safe
        // BECAUSE the core is initialized (buffer/state machine live — the same order the restart
        // path uses after Connection(newConn)), and it is only ever pressed on a NotConnected
        // connection (Start() is not re-entrant). Returns true iff it started one; false for an
        // uninitialized core (the lazy/eager init paths own that case) or any non-dormant
        // connection state. UI thread only.
        Boolean StartDormantConnection();

        // Agentmaster (RENDERING.md): re-point THIS terminal's live renderer at the effective software
        // flag (the profile's `rendering.software` OR SetSoftwareRenderingOverride) and repaint once. A
        // changed value rebuilds the engine's adapter, device and swap chain on the next frame, which
        // also revives a terminal whose GPU surface stopped showing frames. No-op before the terminal
        // initialized (it reads the override then) or while it closes. UI thread only.
        void ReapplySoftwareRendering();
        Windows.Foundation.Size CharacterDimensions { get; };
        Windows.Foundation.Size MinimumSize { get; };
        Single SnapDimensionToGrid(Boolean widthOrHeight, Single dimension);

        void WindowVisibilityChanged(Boolean showOrHide);

        void ScrollViewport(Int32 viewTop);

        // Agentmaster (SUMMARY_JUMP.md): jump the view to where the i-th conversation prompt is rendered,
        // CENTERING it. Returns the buffer row jumped to, or -1 if the prompt isn't on screen.
        Int32 JumpToConversationPrompt(Windows.Foundation.Collections.IVector<String> messages, UInt32 index);
        // Agentmaster (SUMMARY_JUMP.md): a row per prompt (-1 if not on screen) — drives summary-panel icon
        // eligibility dimming. Read-only (no scroll).
        Windows.Foundation.Collections.IVector<Int32> ResolveConversationPromptRows(Windows.Foundation.Collections.IVector<String> messages);
        // Agentmaster (alt+up / alt+down prompt nav): scroll to the nearest SENT prompt that is currently
        // OFF-SCREEN in the given direction (up = above the viewport, down = below), CENTERING it. Returns
        // the 0-based MESSAGE INDEX navigated to (so the caller can highlight that summary row); -1 at a true
        // boundary; or -2 when stepping DOWN past the last prompt scrolled to the BOTTOM / live tail (the
        // caller moves on silently and clears the highlight). At the UP end (nothing off-screen above) it
        // stops at the TOPMOST matched prompt — centers it and returns its index, -1 only once already there.
        Int32 ScrollToAdjacentConversationPrompt(Windows.Foundation.Collections.IVector<String> messages, Boolean up);
        // Agentmaster (PENDING_INPUT.md): the UNSENT draft in Claude's input box (read-only); "" => none.
        String ReadPendingInputDraft();
        // Agentmaster (MESSAGING.md section 21.24): the live screen as a styled snapshot (ScreenSnapshot.h's text format: every
        // cell's glyph, width and resolved colors), for the Telegram card's Screen Image; "" => not initialized. Read-only.
        String ReadScreenSnapshot();
        // Agentmaster (DELIVERY_PLAN.md R5): the tri-state verdict of that same cached scan (Int32
        // InputBoxState — 0 Unknown / 1 NoBox / 2 Empty / 3 Draft / 4 MenuOpen).
        Int32 ReadPendingInputBoxState();
        // Agentmaster (DELIVERY_PLAN.md R4/R5): ONE fresh input-box read at a caller-chosen row window,
        // "<state digit><draft text>" ("" => not initialized). The verified-send read-back channel.
        String ReadInputBoxProbe(Int32 maxRows);
        // Agentmaster (PENDING_INPUT.md §9): the input box's body height in visual rows (newlines + 1);
        // > 1 => it still holds blank "" rows the clear ladders collapse with Ctrl+U. 0 => no box.
        Int32 ReadInputBoxBodyRows();

        void CreateSearchBoxControl();
        Boolean SearchBoxEditInFocus();

        // Agentmaster: shift the (top-right) search box left by this many pixels so it can sit to the
        // LEFT of the per-tab overlay badge. The app measures the badge width and feeds it here; 0
        // restores the default top-right edge position (a non-agent tab never moves it).
        void SetSearchBoxRightInset(Double rightInsetPx);

        void SearchMatch(Boolean goForward);

        void AdjustFontSize(Single fontSizeDelta);
        void ResetFontSize();

        void ToggleShaderEffects();
        void SendInput(String input);
        Boolean RawWriteKeyEvent(UInt16 vkey, UInt16 scanCode, Microsoft.Terminal.Core.ControlKeyStates modifiers, Boolean keyDown);
        Boolean RawWriteChar(Char character, UInt16 scanCode, Microsoft.Terminal.Core.ControlKeyStates modifiers);
        void RawWriteString(String text);

        void BellLightOn();

        Boolean ReadOnly { get; };
        void ToggleReadOnly();
        void SetReadOnly(Boolean readOnlyState);

        String ReadEntireBuffer();
        CommandHistoryContext CommandHistory();
        void UpdateWinGetSuggestions(Windows.Foundation.Collections.IVector<String> suggestions);

        void AdjustOpacity(Single Opacity, Boolean relative);
        void PreviewInput(String text);

        // You'd think this should just be "Opacity", but UIElement already
        // defines an "Opacity", which we're actually not setting at all. We're
        // not overriding or changing _that_ value. Callers that want the
        // opacity set by the settings should call this instead.
        Single BackgroundOpacity { get; };

        CursorDisplayState CursorVisibility;

        Windows.UI.Xaml.Media.Brush BackgroundBrush { get; };

        void ColorSelection(SelectionColor fg, SelectionColor bg, Microsoft.Terminal.Core.MatchMode matchMode);

        Windows.Foundation.Point CursorPositionInDips { get; };
        Double QuickFixButtonWidth { get; };
        Double QuickFixButtonCollapsedWidth { get; };

        void ShowContextMenu();
        Boolean OpenQuickFixMenu();
        void RefreshQuickFixMenu();
        void ClearQuickFix();

        void Detach();

        // Agentmaster (RENDERING.md §4c): re-evaluate whether THIS terminal is on screen and push the
        // current ConfigureHiddenRenderingPolicy to its renderer — how a Settings change reaches terminals
        // that are already hidden. No-op while closing or after Detach. UI thread only. Appended LAST
        // so no existing member changes its vtable slot.
        void ReapplyHiddenRenderingPolicy();
    }
}
