<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests of Amb.Core: the allocation rules (with the measured numbers of DESIGN.md §3.6), the record store's
    atomicity and compare-and-swap, the ids and the request life. They need no VM, no distro and no network, so they
    run on every change: dotnet test buildserver/src/Amb.Core.Tests
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Amb.Core\Amb.Core.csproj" />
  </ItemGroup>
</Project>
