<?xml version="1.0" encoding="utf-8"?>
<!--
  The build server's package sources and package folder.

  The repository's root NuGet.config is Windows Terminal's: it clears nuget.org (so without this file a restore here
  finds neither the test framework nor the SDK's own ILLink package: NU1101), and it sets globalPackagesFolder to
  .\packages, which put the build server's packages on K: (measured 2026-10-25: 19 folders, ~600 MB, removed again).
  So this file names nuget.org alone, and sends packages to the user's ordinary NuGet cache on C: (the folder every other
  .NET project of this PC uses), never to K:.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="%USERPROFILE%\.nuget\packages" />
  </config>
</configuration>
