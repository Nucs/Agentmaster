<?xml version="1.0" encoding="utf-8"?>
<!--
  The build server's package sources. The repository's root NuGet.config is Windows Terminal's (it clears nuget.org and
  names only the Terminal dependency feed), so without this file a restore here finds neither the test framework nor the
  SDK's own ILLink package (NU1101). nuget.org alone: the build server takes no package from anywhere else.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
