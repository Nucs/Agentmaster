<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    amb-coordinator (buildserver/DESIGN.md §6, §10, §12): the build server's one writer. It takes requests over HTTP,
    scores them against what the sites have free (Amb.Core.Allocation), starts their slots through a slot driver, hands
    steps to each slot's guest agent, and records every change atomically (Amb.Core.Records).

    It runs in the site distro (linux-musl-x64, self-contained single file, so the distro needs no .NET install); for
    tests it also runs on Windows with the local slot driver. Until fastrun runs VMs (Track A), the podman driver is the
    stand-in of DESIGN.md §13.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>amb-coordinator</AssemblyName>
    <RootNamespace>Amb.Coordinator</RootNamespace>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The request delegate generator: minimal APIs bound at compile time (no reflection over the handlers). -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Amb.Core\Amb.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Amb.Coordinator.Tests" />
  </ItemGroup>
</Project>
