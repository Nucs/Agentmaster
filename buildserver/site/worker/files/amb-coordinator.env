# The worker site's coordinator settings (installed by buildserver/site/worker.py `provision` as /etc/amb-coordinator.env,
# read by /usr/local/bin/amb-coordinator-run). Every variable is CoordinatorOptions.FromEnvironment's; an EMPTY value
# turns that feature off. Change it here, then `worker.py provision` and `worker.py restart`.

# The site: its folder (drive 2), its address on the home LAN, and how its slots' guests reach it (slirp4netns maps
# 10.0.2.2 to the container's loopback).
AMB_ROOT=/srv/buildserver
AMB_LISTEN=http://0.0.0.0:2207
AMB_GUEST_URL=http://10.0.2.2:2207
AMB_SITE_NAME=worker
AMB_BUILD_LETTER=w
# Always up: no idle exit (it is a service; homepc's lazy site exits after 10 minutes).
AMB_IDLE_EXIT_MINUTES=0

# What it cannot reach: no Windows here (no host-facts helper, no installs), and no K: (commits come by push, e2e
# suites from a commit's e2e folder).
AMB_HOSTFACTS=
AMB_WINDOWS_PWSH=
AMB_SOURCE_REPO=
AMB_E2E_SOURCE=

# Its capacity: the host's own meminfo (bind-mounted by create-ct803.sh), kept 8 GB for the host's other guests (TraderLab's
# worker, the planned Windows Server and k3s VMs); 2 GB below the container's 100 GB ceiling; 20 vCPUs (the host's
# threads); 50 GB of drive 2 kept free for the other guests' temporary data.
AMB_HOST_MEMINFO=/mnt/hostproc/meminfo
AMB_RESERVE_HOST_MEMORY_MIB=8192
AMB_RESERVE_SITE_MEMORY_MIB=2048
AMB_USABLE_VCPUS=20
AMB_RESERVE_DISK_MIB=51200

# Its slots: a build VM of 16-32 GB with 8-16 vCPUs (BuildJob.Parallelism: 4 projects x 3 compilers at 32 GB) and a
# 256 GB sparse data disk; an e2e VM of 6 GB, uncapped (no swap here), with 4-6 vCPUs.
AMB_BUILD_MEMORY_MIB=16384:32768
AMB_BUILD_VCPUS=8:16
AMB_BUILD_DATA_DISK_GIB=256
AMB_E2E_MEMORY_MIB=6144
AMB_E2E_VCPUS=4:6
AMB_E2E_GUEST_MEMORY_MIB=0
# No swap here (the container has none, so a VM's pages never go to drive 1): a capped slot is refused when asked.
AMB_CAPPED_SLOTS=0
# dockur gives a VM's firmware 30 s to start booting Windows, then kills QEMU. This host's UEFI firmware took 20 s on a busy
# day and more than 30 s twice (2026-11-12: the e2e layer's slot and a smoke "stopped by themselves" a minute in), so every
# slot container rewrites that wait to 180 s before dockur starts (PodmanSlotDriver.BootWaitScript).
AMB_DOCKUR_BOOT_WAIT=180

# The coordinator is one process serving a handful of requests: the workstation GC keeps its memory small.
DOTNET_gcServer=0
# OpenRC starts services without a locale, and .NET then writes its console log in ASCII (a "…" became a stray byte,
# 2026-11-12): UTF-8, as the records and event logs are.
LANG=C.UTF-8
